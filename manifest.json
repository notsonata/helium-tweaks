{
  "manifest_version": 3,
  "name": "Helium Bookmarks Sidebar",
  "version": "1.5.1",
  "description": "A right-edge bookmark sidebar for Helium with editing, drag-and-drop organization, and a fallback page for restricted browser tabs.",
  "permissions": ["bookmarks", "storage", "favicon"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Toggle bookmarks sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open the bookmarks sidebar and focus search"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "sidebar-fixes.js",
        "hover-controller.js",
        "bookmark-editor.js",
        "bookmark-dnd.js",
        "native-bookmark-drag.js",
        "bookmark-rename.js",
        "overlay-scrollbar.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.css", "_favicon/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
